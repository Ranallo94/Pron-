# Copia questo file in .env.local (ignorato da Git) e adatta i percorsi al tuo computer.
# Nessun percorso è scritto nel codice: cambiando PC basta cambiare queste righe.

# Cartella OneDrive con le vecchie app (Formulito, Championsito, Medusino, Mondialito, Wimbledino).
# Serve ai test di parità: se manca, quei test vengono saltati.
PRONO_SATELLITI_DIR=C:\Users\NOME\OneDrive - Pini Group\Personale\14-Pronò!

# Cartella OneDrive dove `npm run onedrive` copia i documenti da leggere anche dal telefono.
PRONO_ONEDRIVE_DIR=C:\Users\NOME\OneDrive - Pini Group\Personale\14-Pronò!\Repository-documenti

# Java per gli emulatori Firebase (JDK 17 o superiore). Se Java è già nel PATH si può omettere.
# Installazione senza amministratore: scarica lo zip di Temurin 21 (adoptium.net) e decomprimilo in una cartella tua.
PRONO_JAVA_HOME=C:\Users\NOME\AppData\Local\Programs\Java\jdk-21

# --- Firebase (configurazione web dell'app) ---
# Si trova in Console Firebase → Impostazioni progetto → "Le tue app" → App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
